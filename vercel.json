{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)\\.(jpe?g|png|webp|svg|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)\\.(html|js|css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://www.googletagmanager.com 'sha256-2LWQQtsDkhm+rcSzNHT5om/zkcntoYlHl0A6TXCAf2Q=' 'sha256-4Ru1qQgAK/yntA8j19fCWxMmoJaDlOfqzwO3qe6cj3E=' 'sha256-5K8CdCVRF2U2sMbOBKJqfZDFZ4ZEQ6t0q7wS+Q3D2ug=' 'sha256-9hDRaYN9MZ2fznvfoeyidKLR803Ezd6zBdvTG/WdJgA=' 'sha256-KRTs9PQZzWIC+dc4gCs+5A7cOc7rRpfL/0FQ2HmDUfU=' 'sha256-LNFwsA2IIn5BVHcvbqGqGaceKjjDH+ev8FI/f+XT58g=' 'sha256-PRiZ/SCmsPCrhZ2mhsbT5NpQWlxRjZ6N2G4DctPWSPI=' 'sha256-XJH4nrBKQCd6lktjjEOy1hbtXFNZ3fG80LJz1W1Ydgg=' 'sha256-YDwEkSzwGCoNjebNzan4K975x7S9mDLsavrh9rqAu8Q=' 'sha256-ZkdiipPbrTK+ARiGjzmbAvc3UDXHd4QRMEHcrHKabms='; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://*.google-analytics.com https://*.analytics.google.com; media-src 'self'; frame-src https://www.google.com; frame-ancestors 'self'; form-action 'self'; base-uri 'self'; object-src 'none'; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com"
        }
      ]
    },
    {
      "source": "/crm/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/crm",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "crm.kingsonengineering.co.zw"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "kingson-engineering.vercel.app"
        }
      ],
      "destination": "https://www.kingsonengineering.co.zw/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "kingson-engineering.vercel.app"
        }
      ],
      "destination": "https://www.kingsonengineering.co.zw/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "crm.kingsonengineering.co.zw"
        }
      ],
      "destination": "/crm",
      "permanent": false
    },
    {
      "source": "/fiber-laser-cutting-harare",
      "destination": "/fibre-laser-cutting-harare",
      "permanent": true
    }
  ]
}
