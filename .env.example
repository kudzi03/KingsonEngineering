# Kingson Engineering website — environment variables (placeholders only).
#
# Real values are set in Vercel: Project → Settings → Environment Variables,
# for the Production environment. Never commit real values and never paste
# them into chat, email or a document. See docs/ENQUIRIES_GOOGLE_SHEETS.md.

# The spreadsheet's ID: the long string between /d/ and /edit in its address.
GOOGLE_SHEET_ID=replace-with-spreadsheet-id

# The service account's address, from the Google Cloud console.
GOOGLE_SERVICE_ACCOUNT_EMAIL=enquiries@replace-with-project-id.iam.gserviceaccount.com

# The service account's private key (the "private_key" value of its JSON key
# file), on one line with \n where the line breaks are. Mark it Sensitive in Vercel.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-key\n-----END PRIVATE KEY-----\n"

# Optional. The worksheet (tab) name. Leave it out to use the first tab of the
# spreadsheet. Set it only if the enquiries tab is not the first one.
# GOOGLE_SHEET_TAB=Enquiries
